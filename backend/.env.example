# Variables de entorno de ejemplo para el backend de Sonido Vivo (Spring Boot)
# Se usan al ejecutar con el perfil mysql (-Dspring-boot.run.profiles=mysql) o para sobreescribir JWT.

# Base de datos MySQL / MariaDB (XAMPP)
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Configuración JWT (la clave debe tener al menos 32 bytes)
JWT_SECRET=sonidovivo-clave-jwt-de-desarrollo-32bytes
JWT_EXPIRATION_MINUTES=120
